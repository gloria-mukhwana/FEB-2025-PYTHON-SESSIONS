from abc import ABC, abstractmethod

class AbstractVehicle(ABC):
    @abstractmethod
    def move(self):
        pass

class Car(AbstractVehicle):
    def move(self):
        print("Driving ")

class Plane(AbstractVehicle):
    def move(self):
        print("Flying ")

class Train(AbstractVehicle):
    def move(self):
        print("Chugging along ")

class Ferry(AbstractVehicle):
    def move(self):
        print("Sailing smoothly ")

my_car = Car()
my_plane = Plane()
my_train = Train()
my_ferry = Ferry()

my_car.move()  
my_plane.move() 
my_train.move()  
my_ferry.move()
